    <!-- Onboarding -->
    <string name="ob_tagline">A familiar that feeds on stories</string>
    <string name="ob_intro">You are a reading mage, and every mage needs a familiar. Yours lives on mana, and mana comes from pages: each page you read is a spark it eats.</string>
    <string name="ob_intro2">Read and it hatches, grows and learns. Forget about books and it slowly turns to stone, until a few pages break the spell.</string>
    <string name="ob_choose">Choose an egg</string>
    <string name="ob_choose_text">Each familiar loves its own kind of reading. Nine more are found along the way.</string>
    <string name="ob_others">The dragon, the phoenix, the griffin, the owlbear, the moon moth, the tanuki, the sprout, the ghost, the bookworm, the chimera and the magpie come to those who read.</string>
    <string name="ob_names">What will you call it?</string>
    <string name="ob_pet_name">Familiar\'s name</string>
