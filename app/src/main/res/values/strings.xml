    <string name="ob_book_text">Add the book on your nightstand. Paper, e-book or audiobook: you count the pages.</string>
    <string name="ob_remind">Evening reminder at 21:00</string>
    <string name="ob_remind_sub">The familiar asks for a story; quiet on days you\'ve read</string>
